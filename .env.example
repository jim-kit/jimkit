# Copy to .env (install/install.sh does this for you). Never commit the real one.
# Full list with explanations: docs/configuration.md

# 32+ random characters: signs the unlock cookie. Without it (and a code hash) unlocking is switched off.
# Make one with: openssl rand -hex 32
JIMKIT_SESSION_SECRET=

# From: node cli/jimkit.mjs unlock-hash "your code"      (keep the single quotes: the value contains $)
JIMKIT_UNLOCK_HASH=

# 0 = Jimkit is reached directly. 1 = one reverse proxy (Nginx, Traefik, Caddy, a Cloudflare Tunnel...) sits in front of it.
# Get this right: it decides who counts as "on your network". See docs/security.md.
JIMKIT_PROXY_HOPS=0

# Addresses treated as your own network. Default: loopback, the private ranges and Tailscale's 100.64.0.0/10.
# JIMKIT_TRUSTED_CIDRS=192.168.1.0/24,100.64.0.0/10

# Names this instance answers to (comma separated, *.example.org allowed). A request under any other name counts as public.
# Needed only if you reach Jimkit from inside your network by a public name. See docs/security.md.
# JIMKIT_ALLOWED_HOSTS=jimkit.example.org

# Minutes an unlock lasts
# JIMKIT_UNLOCK_TTL_MINUTES=60

# Which image to build: lite (no conversion engines, ~400 MB) or full (everything, ~1.8 GB). Only read by `docker compose build`.
JIMKIT_VARIANT=full
JIMKIT_PORT=3000

# Which of this machine's addresses the port is published on. With a reverse proxy in front (PROXY_HOPS above 0), set this to
# 127.0.0.1 if the proxy runs on this machine, or to this machine's LAN address if it runs elsewhere, so nobody can reach
# Jimkit around the proxy. 0.0.0.0 = every network.
JIMKIT_BIND=0.0.0.0
